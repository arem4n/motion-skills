{
  "_doc": "Archetype -> motion personality. tempo multiplies every duration (>1 = slower). ease.in is for things arriving, ease.move for things travelling, ease.settle for the last 20% of a gesture. stagger is the base delay between siblings. overshoot is how far a move may pass its target (0 = never). hold is the silence, in seconds, left after a beat lands. cut=true means hard cuts / snaps are on-brand. Sources: Mark & Pearson archetypes from the LogocodeX manual (fear column drives `avoid`).",
  "defaults": {
    "tempo": 1.0,
    "ease": { "in": "power2.out", "move": "power2.inOut", "settle": "sine.out" },
    "stagger": 0.1,
    "overshoot": 0,
    "hold": 0.4,
    "drift": 1.015,
    "cut": false,
    "rhythm": "legato",
    "entrance": "rise",
    "avoid": []
  },
